APP_NAME=CryptoBot API
APP_VERSION=0.1.0
DATABASE_URL=sqlite:///./crypto_bot.db
SIMULATION_INITIAL_BALANCE=20
SIMULATION_FEE_RATE=0.001
MONGO_URI=
SKIP_DB=false

SIMULATION_BOT_ENABLED=false
SIMULATION_BOT_INTERVAL_SECONDS=60
SIMULATION_BOT_ACCOUNT_ID=1
SIMULATION_BOT_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
SIMULATION_BOT_CAPITAL_USD=5

SIMULATION_BOT_MAX_TRADE_USD=5
SIMULATION_BOT_MIN_PROFIT_USD=0.05
SIMULATION_BOT_MIN_PROFIT_PERCENT=0.10
SIMULATION_BOT_MIN_LIQUIDITY_USD=10
SIMULATION_BOT_MAX_POSITION_USD=20
SIMULATION_BOT_MAX_QUOTE_AGE_SECONDS=5
SIMULATION_BOT_MAX_SLIPPAGE_PERCENT=0.20
SIMULATION_BOT_COOLDOWN_SECONDS=300
SIMULATION_BOT_MAX_TRADES_PER_DAY=3

# Fase 1 — Binance Spot (spec 001). Nunca poner true sin haber aprobado RF-16.
ALLOW_LIVE_TRADING=false
CONFIGURED_CAPITAL_USD=20
API_TOKEN=

TRADING_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT,DOGEUSDT,ADAUSDT,LINKUSDT
# Pares con señal técnica ORB (spec 001, D-12); el resto solo señales externas.
ORB_SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT
TRADING_INTERVAL_SECONDS=60
STOP_LOSS_PCT=2.0
# D-11: RR 1:1 — TAKE_PROFIT_PCT debe igualar STOP_LOSS_PCT.
TAKE_PROFIT_PCT=2.0
MAX_SIGNAL_PRICE_DISTANCE_PCT=1.0
SIGNAL_TTL_SECONDS=300

# Binance Spot Testnet - keep empty until authenticated testnet access is available.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET_BASE_URL=https://testnet.binance.vision
BINANCE_RECV_WINDOW_MS=5000

# OKX Demo Trading - create these from the Demo Trading API area.
OKX_DEMO_API_KEY=
OKX_DEMO_API_SECRET=
OKX_DEMO_API_PASSPHRASE=
OKX_DEMO_BASE_URL=https://openapi.okx.com
OKX_DEMO_TIMEOUT_SECONDS=10

# Informe diario por correo (spec 002, RF-7). REPORT_TO vacío = no envía nada (RF-4).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
REPORT_TO=

# Keepalive antispin-down en Render (spec 002, RF-1). Vacío = desactivado.
KEEPALIVE_URL=

# Orígenes CORS permitidos, CSV (spec 002, RF-8): añadir la URL de GitHub Pages en despliegue.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# Observabilidad (spec 005, RF-1/RF-8): retencion de eventos, nivel de log
# y version de estrategia que viaja en cada evento estructurado.
EVENT_RETENTION_DAYS=30
LOG_LEVEL=INFO
STRATEGY_VERSION=orb-001-v3

# Datos y contexto (spec 006, D-2): fuentes declaradas. FEAR_GREED_URL vacio
# desactiva la fuente (DISABLED); NEWS_RSS_FEEDS es un CSV de feeds RSS
# (vacio = sin noticias, DISABLED).
FEAR_GREED_URL=https://api.alternative.me/fng/
NEWS_RSS_FEEDS=
# TTL de la caché en memoria (segundos): depth 30 s, Fear&Greed 6 h, news 15 min.
DEPTH_CACHE_SECONDS=30
FEAR_GREED_CACHE_SECONDS=21600
NEWS_CACHE_SECONDS=900
# Pesos del score de candidatos (RF-6): CSV clave:peso con suma 1;
# mal formado o suma != 1 -> pesos por defecto + evento config.ignored.
CANDIDATE_WEIGHTS=momentum:0.30,volume:0.25,trend:0.25,range:0.20

# Analista IA con Gemini (spec 007). SOLO tier gratuito: presupuesto duro
# 0 USD, nunca habilitar pago (constitución 3-4). GEMINI_API_KEY vacío =
# DISABLED. Confirmar GEMINI_MODEL con la doc oficial al crear la clave.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_SECONDS=10
GEMINI_MAX_RETRIES=2
GEMINI_DAILY_QUERY_LIMIT=4
GEMINI_CACHE_SECONDS=3600
GEMINI_BREAKER_FAILURES=3
GEMINI_BREAKER_SECONDS=900
# Pasada diaria opcional (RF-8); el loop de la spec 001 no se toca.
GEMINI_AUTO_ANALYSIS=false
GEMINI_AUTO_ANALYSIS_LIMIT=3
# Coste USD por millón de tokens; 0 = sin coste registrado ni corte (free tier).
GEMINI_DAILY_BUDGET_USD=0
GEMINI_PRICE_MTOK_INPUT=0
GEMINI_PRICE_MTOK_OUTPUT=0

# Risk engine v2 (spec 008): tope de exposición total (% del capital
# aportado, base CONFIGURED_CAPITAL_USD) y umbral de correlación positiva
# que dispara el resize a la mitad del share (D-2/D-3).
RISK_MAX_TOTAL_EXPOSURE_PCT=75
RISK_CORRELATION_THRESHOLD=0.7